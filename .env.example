# Bu makinede baska bir servis 8000 portunu kullaniyorsa degistirin
API_PORT=8010

# ./data klasoru docker-compose.yml icinde kalici bir birim (volume) olarak
# baglanmistir; veritabanini bu klasorun disina koymayin, yoksa her
# `docker compose up --build` sonrasinda silinir.
DATABASE_URL=sqlite:///./data/sertek_alpr.db
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
WATCHLIST_ENCRYPTION_KEY=change-this-fernet-key-see-readme
PLATE_DETECTOR_MODEL_PATH=models/plate_detector.onnx
# Plaka KUTUSUNU bulma esigi (tespit motoru bu deger altindaki kutulari
# hic dondurmez).
DETECTION_CONFIDENCE_THRESHOLD=0.5
# Nihai kutu+OCR ORTALAMA guven esigi (bir okumanin kaydedilip
# kaydedilmeyecegine karar verir). Bilerek yukaridakinden dusuk: gercek
# kamera goruntusunde OCR guveni dogru okumalarda bile dusuk cikabilir.
# Hic sonuc gorunmuyorsa dusurun (orn. 0.2); yanlis okumalar cok
# gorunuyorsa yukseltin (orn. 0.4).
MIN_PLATE_READ_CONFIDENCE=0.3
COMPANY_NAME=Sertek Bilisim
# tesseract: varsayilan, gercek dunyada genelde daha kararli. easyocr:
# bazi kameralarda daha iyi olabilir ama denendiginde bazen daha da kotu
# sonuc verebilir (kamera acisi/fontuna gore degisir) - degistirmeden
# once test edin, kotu giderse tesseract'a geri donun (bkz. README -
# OCR Motoru Secimi). Ikisi de calisma zamaninda internet gerektirmez.
OCR_ENGINE=tesseract
# Turkiye plakalarinin solundaki mavi TR/AB bandi, tespit kutusuna dahil
# oldugunda OCR'a karisip plaka metninin basina hatali karakterler
# ekleyebiliyor (orn. gercek "07 MYS 57" -> "97MYS57", "402HYS57" gibi
# okundu - sondaki "MYS57" sabit kaldi ama bastaki "07" her seferinde
# farkli bozuldu). Kirpmanin bu kadarlik bir payi solundan kesilip OCR'a
# hic gosterilmiyor. Sorun devam ederse artirin (orn. 0.18); gercek ilk
# karakter kesiliyor gibi gorunuyorsa azaltin.
PLATE_CROP_LEFT_TRIM_FRACTION=0.12

# --- E-posta / Bildirim (opsiyonel; SMTP_HOST bos ise e-posta gonderilmez) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alpr@sertekbilisim.com
SMTP_USE_TLS=true

# Bu kategoride bir plaka tespit edilince aninda e-posta uyarisi gonderilir
ALERT_CATEGORIES=wanted,blacklist
# Virgulle ayrilmis alici listesi, orn: guvenlik@musteri.com,yonetici@musteri.com
ALERT_TO=

# Her gun DAILY_REPORT_HOUR saatinde (0-23, sunucu saatine gore) otomatik
# gunluk ozet raporu gonderilir. Bos birakilirsa gunluk rapor gonderilmez.
DAILY_REPORT_TO=
DAILY_REPORT_HOUR=8

# Otopark kapasitesi (toplam arac sayisi). Panelden "Kapasiteyi Duzenle" ile
# de degistirilebilir; panelden degistirilen deger bu varsayilani gecersiz kilar.
PARKING_CAPACITY=50

# Is Makinasi Takip (varsayilan gizli, panelden yonetici tarafindan acilir):
# ayni plaka/kapi icin bu sure icindeki tekrar okumalar tek gecis sayilir
EQUIPMENT_CROSSING_DEBOUNCE_SECONDS=30
# OCR'in gecerli bir ekipman kodu saymasi icin gereken en az karakter sayisi
EQUIPMENT_MIN_CODE_LENGTH=3

# app.camera_worker (ana ALPR kamera izleyicisi) icin servis kullanicisi.
# "Kullanicilar" sekmesinden (veya scripts/seed_admin.py benzeri bir script
# ile) bu ad/sifreyle bir kullanici olusturmaniz gerekir.
WORKER_USERNAME=
WORKER_PASSWORD=
# Canli video akisina (MJPEG) gonderilecek karenin ne siklikla guncellenecegi
# (saniye) - dusurmek daha akici gorunum saglar ama CPU/ag yukunu artirir
PREVIEW_INTERVAL_SECONDS=0.1
# Canli onizleme karelerinin JPEG kalitesi (1-100) - dusurmek dosyayi
# kucultup akiciligi artirir; SADECE onizlemeyi etkiler, plaka tespiti
# (OCR) her zaman tam kalitede ayri kodlanir, bundan etkilenmez
PREVIEW_JPEG_QUALITY=70
# Kamera listesinin (yeni eklenen/silinen kameralar icin) ne siklikla
# yeniden kontrol edilecegi (saniye)
CAMERA_LIST_REFRESH_SECONDS=10
# Ayni kamera icin tespit (OCR) ne siklikla calisacak (saniye) - onizleme
# akiciliginin aksine bu, gereksiz yere sik calistirilmamali: her deneme
# gercek bir ONNX + Tesseract calistirir (CPU agirlikli), kamera FPS'i
# kadar (orn. saniyede 20-25 kez) calistirmak sunucuyu tikayabilir/
# istekleri kuyruga yigabilir. Asagidaki "cogunluk oylamasi" (BURST_*)
# zaten birkaç denemeyi birlestirdigi icin bu degeri asiri dusurmeye
# genelde gerek yok; 0.5-1 araligi cogu sunucu icin makul bir baslangictir.
CAPTURE_INTERVAL_SECONDS=2

# Ayni aracin ardisik kareleri icin okunan plakalar, tek tek kaydetmek
# yerine kisa sureli bir havuzda birikip COGUNLUK OYLAMASIYLA TEK bir
# sonuc olarak kaydedilir (bkz. app/detection_burst.py) - cunku tek kare
# guveni dogru/yanlis okumayi guvenilir sekilde ayirt etmiyor, ama ayni
# gecişteki BIRDEN FAZLA denemede dogru okuma genelde daha sik tekrarlanir.
# Son adaydan bu kadar saniye gecince (arac goruntuden ayrilmis sayilir)
# havuz sonuclandirilir:
DETECTION_BURST_GAP_SECONDS=4
# Ardisik adaylar arasinda hic bosluk olmasa bile (orn. bariyerde bekleyen
# bir arac), havuzun suresiz birikmemesi icin ust sinir (saniye):
DETECTION_BURST_MAX_SECONDS=20

# app.equipment_gate_worker icin servis kullanicisi (bos ise WORKER_USERNAME/
# WORKER_PASSWORD kullanilir)
EQUIPMENT_WORKER_USERNAME=
EQUIPMENT_WORKER_PASSWORD=
